# --- meta ---
APP_VERSION=0.1.0
ENVIRONMENT=development

# --- cors ---
# Comma-separated list of allowed origins. Use "*" only in local dev.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- database ---
# Locally optional (the app boots without it). In production Railway injects
# DATABASE_URL automatically via the Postgres service reference.
DATABASE_URL=

# --- auth (placeholders — replace before going live) ---
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480
